{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "nesbot/carbon": "^3.15.0",
        "doctrine/dbal": "^3.10.6",
        "doctrine/doctrine-bundle": "^2.19.1",
        "doctrine/doctrine-migrations-bundle": "^3.7.1",
        "doctrine/orm": "^3.7.5",
        "endroid/qr-code": "^6.1.3",
        "erusev/parsedown": "^1.8.0",
        "friendsofsymfony/ckeditor-bundle": "^2.8.0",
        "google/recaptcha": "^1.5.2",
        "h4cc/wkhtmltopdf-amd64": "^0.12.4",
        "khanamiryan/qrcode-detector-decoder": "^2.0.3",
        "knplabs/doctrine-behaviors": "v3.0.0",
        "knplabs/knp-snappy-bundle": "^1.10.6",
        "liip/imagine-bundle": "^2.18.1",
        "phpdocumentor/reflection-docblock": "^5.6.7",
        "phpstan/phpdoc-parser": "^2.3.6",
        "phpoffice/phpspreadsheet": "^5.10.0",
        "setbased/rijksregisternummer": "^1.6.1",
        "symfony/asset": "7.4.*",
        "symfony/asset-mapper": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/doctrine-messenger": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/flex": "^2.11.0",
        "symfony/form": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/intl": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/notifier": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/property-info": "7.4.*",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stimulus-bundle": "^2.36",
        "symfony/string": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/ux-autocomplete": "^2.36.2",
        "symfony/ux-turbo": "^2.36",
        "symfony/validator": "7.4.*",
        "symfony/web-link": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/extra-bundle": "^2.12|^3.29",
        "symfonycasts/reset-password-bundle": "^1.25.0",
        "symfonycasts/verify-email-bundle": "^1.18.0",
        "twig/cssinliner-extra": "^3.26",
        "twig/inky-extra": "^3.26",
        "twig/intl-extra": "^3.30",
        "twig/markdown-extra": "^3.29",
        "twig/string-extra": "^3.24",
        "twig/twig": "^2.12|^3.30.0",
        "vich/uploader-bundle": "^2.10.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App",
            "AcMarche\\Mercredi\\": "src/AcMarche/Mercredi/src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd",
            "ckeditor:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "7.4.*"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.40",
        "symfony/browser-kit": "7.4.*",
        "symfony/css-selector": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/maker-bundle": "^1.68",
        "symfony/stopwatch": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    }
}
