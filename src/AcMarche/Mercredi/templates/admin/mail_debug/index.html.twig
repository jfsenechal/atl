{% extends '@AcMarcheMercrediAdmin/layout.html.twig' %}

{% block title %}Diagnostic des mails{% endblock %}

{% macro queue_table(queue) %}
    {% if queue.error %}
        <div class="alert alert-danger mb-0">Lecture de la file impossible : {{ queue.error }}</div>
    {% elseif queue.messages is empty %}
        <p class="text-muted mb-0">Aucun message.</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm table-striped mb-0">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Sujet</th>
                    <th>De</th>
                    <th>A</th>
                    <th>Tentatives</th>
                    <th>Dernière erreur</th>
                </tr>
                </thead>
                <tbody>
                {% for message in queue.messages %}
                    <tr>
                        <td>{{ message.id }}</td>
                        <td>{{ message.subject ?? message.type }}</td>
                        <td>{{ message.from }}</td>
                        <td>{{ message.to }}</td>
                        <td>
                            {{ message.retry_count ?? 0 }}
                            {% if message.retried_at %}
                                <br><small class="text-muted">{{ message.retried_at|date('d/m/Y H:i') }}</small>
                            {% endif %}
                        </td>
                        <td class="text-danger"><small>{{ message.error }}</small></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endmacro %}

{% block body %}
    <div class="card mb-3">
        <div class="card-header">
            <h3>Diagnostic des mails</h3>
        </div>
        <div class="card-body">
            <h4>Configuration</h4>
            <table class="table table-sm">
                <tr>
                    <th style="width: 30%">Serveur (MAILER_DSN)</th>
                    <td><code>{{ dsn }}</code></td>
                </tr>
                <tr>
                    <th>Expéditeur des factures</th>
                    <td>{{ sender }}</td>
                </tr>
                <tr>
                    <th>Adresse de contact</th>
                    <td>{{ contact }}</td>
                </tr>
                <tr>
                    <th>Envoi par l'application</th>
                    <td>
                        {% if routing is empty %}
                            <span class="badge bg-success">Direct</span> les mails partent immédiatement.
                        {% else %}
                            <span class="badge bg-warning text-dark">File : {{ routing|join(', ') }}</span>
                            les mails sont mis en attente et ne partent que lorsque la file est traitée
                            (<code>messenger:consume</code> ou le bouton ci-dessous).
                        {% endif %}
                    </td>
                </tr>
            </table>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                Mails en attente (async)
                <span class="badge bg-{{ asyncQueue.count ? 'warning text-dark' : 'secondary' }}">{{ asyncQueue.count ?? '?' }}</span>
            </h4>
            <form method="post" action="{{ path('mercredi_admin_mail_debug_consume') }}" data-turbo="false">
                <input type="hidden" name="_token" value="{{ csrf_token('mail-debug-consume') }}">
                <button class="btn btn-sm btn-primary" type="submit">
                    <i class="fas fa-play"></i> Traiter la file maintenant (20 max)
                </button>
            </form>
        </div>
        <div class="card-body">
            {{ _self.queue_table(asyncQueue) }}
            {% if consumeOutput is not null %}
                <h5 class="mt-3">Résultat du traitement</h5>
                <pre class="bg-light p-2 border small" style="max-height: 400px; overflow: auto">{{ consumeOutput ?: '(aucune sortie)' }}</pre>
            {% endif %}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h4 class="mb-0">
                Mails en échec (failed)
                <span class="badge bg-{{ failedQueue.count ? 'danger' : 'secondary' }}">{{ failedQueue.count ?? '?' }}</span>
            </h4>
        </div>
        <div class="card-body">
            {{ _self.queue_table(failedQueue) }}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h4 class="mb-0">Envoyer un mail de test</h4>
        </div>
        <div class="card-body">
            {% if sendResult %}
                <div class="alert alert-{{ sendResult.success ? 'success' : 'danger' }}">
                    {{ sendResult.success ? 'Le serveur a accepté le mail.' : 'Echec : ' ~ sendResult.error }}
                </div>
                {% if sendResult.debug %}
                    <h5>Conversation avec le serveur</h5>
                    <pre class="bg-light p-2 border small" style="max-height: 400px; overflow: auto">{{ sendResult.debug }}</pre>
                {% endif %}
            {% endif %}

            {{ form_start(form, {attr: {'data-turbo': 'false'}}) }}
            <div class="row">
                <div class="col-md-6">{{ form_row(form.from) }}</div>
                <div class="col-md-6">{{ form_row(form.to) }}</div>
            </div>
            {{ form_row(form.subject) }}
            {{ form_row(form.mode) }}
            <button class="btn btn-primary" type="submit"><i class="far fa-paper-plane"></i> Envoyer</button>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
